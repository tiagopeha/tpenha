# ── Chaves de API obrigatórias ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Configurações opcionais ──────────────────────────────────────────────────
TDAH_BASE_DIR=~/tdah-ia            # pasta onde os markdowns são salvos
TDAH_EDITOR=code                   # editor pra abrir o arquivo (code, obsidian, etc)
TDAH_CLAUDE_MODEL=claude-opus-4-7  # modelo Claude a usar

# ── Samsung Health (opcional) ────────────────────────────────────────────────
# Integra dados de atividade (passos, sono, FC, exercícios) nos blocos de rotina.
#
# Como configurar:
#   1. Acesse: https://developer.samsung.com/health/server-api
#   2. Crie um app e obtenha as credenciais abaixo
#   3. Execute: tdah saude --autorizar  (abre o browser p/ login Samsung)
#
SAMSUNG_HEALTH_CLIENT_ID=seu-client-id
SAMSUNG_HEALTH_CLIENT_SECRET=seu-client-secret
